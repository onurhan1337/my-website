{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-website",
  "compatibility_date": "2026-04-19",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "vars": {
    "KIZZLE_KEY_ID": "kzl_REPLACE_ME"
  }
}
